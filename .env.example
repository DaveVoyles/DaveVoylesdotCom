# Environment variables for the video pipeline and related tooling
#
# IMPORTANT: This file is a reference/template only. Actual credential values
# must NEVER be committed to this repository.
#
# All credentials live OUTSIDE this repository at paths like:
#   ~/.config/davevoyles-video/credentials.json
#   ~/.config/davevoyles-video/api-keys.json
#
# The variables below point to those external credential locations; do NOT
# paste actual secrets into this file or a .env file in this repository.
#
# Copy this file to .env or .env.local and update the paths to match your
# local setup if needed, but the .env files are git-ignored and will never
# be committed.

# Path to the Google OAuth credentials file (external to this repo)
GOOGLE_OAUTH_CREDENTIALS_PATH=~/.config/davevoyles-video/credentials.json

# Path to additional API keys or secrets (external to this repo)
# API_KEYS_PATH=~/.config/davevoyles-video/api-keys.json
